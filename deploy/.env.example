# rugen-server settings (copy to .env, or paste into Dokploy's Environment
# tab). Everything is optional. The Cloudflare Tunnel add-on has its own
# compose in deploy/cloudflared/ (CF_TUNNEL_TOKEN goes there).

# --- rugen-server ------------------------------------------------------------
# Public URL players put in rugen.toml ([net] server) or the ONLINE screen.
RUGEN_PUBLIC_URL=https://rugen.example.com

# Name and message of the day shown in the in-game server list.
RUGEN_NAME=my rugen server
RUGEN_MOTD=be nice, have fun

# Host:port players send UDP match traffic to (the server's own address,
# never a player's). Must NOT go through Cloudflare's proxy: use the VPS IP
# or a DNS-only (grey cloud) record such as udp.example.com. When empty the
# host of RUGEN_PUBLIC_URL is used, which only works if that record is
# DNS-only; otherwise clients fall back to the WebSocket relay (still fine,
# a bit slower).
RUGEN_UDP_PUBLIC=

# Set to "off" to disable the UDP relay (WebSocket relay only, no open port).
# RUGEN_UDP_BIND=off

# Cloudflare Realtime TURN (real UDP for matches behind a tunnel; see
# deploy/README.md "2b"). Off unless both are set. Secrets: never commit them.
# RUGEN_CF_TURN_KEY_ID=
# RUGEN_CF_TURN_TOKEN=
# Optional usage cross-check with Cloudflare analytics:
# RUGEN_CF_ACCOUNT_ID=
# RUGEN_CF_ANALYTICS_TOKEN=
# Hard monthly cap (decimal GB; Cloudflare's free tier is 1000 GB):
# RUGEN_TURN_BUDGET_GB=500
# RUGEN_TURN_SOFT_PERCENT=80
# RUGEN_TURN_MAX_MATCHES_PER_HOUR=12
# RUGEN_TURN_MAX_MATCHES_PER_DAY=60

# Log level: error, warn, info, debug (client IPs only appear at debug).
RUST_LOG=info

# Image to run (default: the GHCR image published by the release workflow).
# RUGEN_IMAGE=ghcr.io/rugen-dev/rugen-server:v0.3.0

# Host ports (defaults 8080 / 7001):
# RUGEN_HTTP_PORT=8080
# RUGEN_UDP_PORT=7001

# Set by docker-compose.yml, listed for completeness:
#   RUGEN_BIND=0.0.0.0:8080   HTTP + WebSocket (lobby, /ws, /relay, /health)
#   RUGEN_UDP_BIND=0.0.0.0:7001
#   RUGEN_DATA=/data          SQLite database rugen.db (volume rugen-data)
